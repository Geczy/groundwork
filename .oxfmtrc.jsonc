{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  // prettier-plugin-tailwindcss's algorithm, built in. `stylesheet` is what teaches it the
  // `@theme inline` tokens: without it, `bg-primary` and friends are unknown classes and get
  // parked at the front of the list instead of sorted in. `functions` covers `cn()` and
  // `cva()` args, which are otherwise left alone.
  "sortTailwindcss": {
    "stylesheet": "src/styles/index.css",
    "functions": ["cn", "cva"],
  },
  // Vendored component, agent and lint-plugin assets are maintained by their own installers.
  // Keep them out of application formatting so `bun run check` does not rewrite generated or
  // externally sourced guidance.
  "ignorePatterns": [
    "dist",
    "src/routeTree.gen.ts",
    "src/components/ui",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
  ],
}
