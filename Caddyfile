:80 {
  encode zstd gzip

  header {
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
  }

  handle /healthz {
    respond "ok" 200
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server {
      precompressed br
    }
  }
}
